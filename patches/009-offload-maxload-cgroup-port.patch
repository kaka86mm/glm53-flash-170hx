@@ -224,18 +224,73 @@ class SpinCondition:
 SHM_PATH = "/dev/shm"
 
 
-def check_shm_free_space(required_bytes: int, shm_path: str = SHM_PATH) -> None:
-    """Raise if ``shm_path`` cannot fit a ``required_bytes`` shared segment.
+def _check_cgroup_memory_available(
+    required_bytes: int,
+    allocation_name: str = "SHM allocation",
+) -> None:
+    """Log cgroup memory headroom for an upcoming SHM allocation.
+
+    Port of vLLM PR #54014 (self-contained; reads cgroup v2/v1 limits and
+    usage, logs a warning when headroom is below the request but does not
+    reject — cgroup usage may be reclaimable).
+    """
+    import sys as _sys
+
+    if _sys.platform != "linux":
+        return
+
+    def _read_int(path: str) -> int | None:
+        try:
+            with open(path) as f:
+                v = int(f.read().strip())
+            return v if v >= (1 << 62) else v if v != 0 else None
+        except (OSError, ValueError):
+            return None
+
+    # cgroup v2 unified hierarchy
+    v2_limit = _read_int("/sys/fs/cgroup/memory.max")
+    if v2_limit is not None:
+        usage = _read_int("/sys/fs/cgroup/memory.current")
+        limit = v2_limit
+    else:
+        # cgroup v1
+        limit = _read_int("/sys/fs/cgroup/memory/memory.limit_in_bytes")
+        usage = _read_int("/sys/fs/cgroup/memory/memory.usage_in_bytes")
+
+    if limit is None or usage is None:
+        return
+
+    available = max(0, limit - usage)
+    mib = 1 << 20
+    remaining = available - required_bytes
+    if remaining < 0:
+        import logging
+
+        logging.getLogger(__name__).warning(
+            "Cgroup memory preflight for %s: %.0f MiB required, "
+            "%.0f MiB available under %.0f MiB limit; allocation will still "
+            "be attempted because cgroup usage may be reclaimable.",
+            allocation_name,
+            required_bytes / mib,
+            available / mib,
+            limit / mib,
+        )
+
 
-    Args:
-        required_bytes: Size of the shared-memory segment to be created.
-        shm_path: Mount point backing POSIX shared memory; skipped if absent.
+def check_shm_free_space(
+    required_bytes: int,
+    shm_path: str = SHM_PATH,
+    allocation_name: str = "SHM allocation",
+) -> None:
+    """Raise if ``shm_path`` cannot fit a ``required_bytes`` shared segment.
 
-    Raises:
-        RuntimeError: If ``required_bytes`` exceeds the free space.
+    Also logs a warning when the cgroup memory headroom is below the
+    allocation (the allocation is still attempted — cgroup usage may be
+    reclaimable).
     """
     if not os.path.isdir(shm_path):
         return
+    _check_cgroup_memory_available(required_bytes, allocation_name)
     free_bytes = shutil.disk_usage(shm_path).free
     if required_bytes <= free_bytes:
         return
